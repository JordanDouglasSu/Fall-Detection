#include <Arduino.h>
#include <math.h>
#include <string.h>

#define RXD2 16
#define TXD2 17

// ---------- Tunable Thresholds (speeds in cm/s, distances in mm) ----------
#define SPEED_PEAK_CMS      50    // min speed to count as a fall burst
#define SPEED_JUMP_CMS      30    // rise vs. slowest of last 2 active frames
#define SPEED_HIGH_CMS      90    // very fast movement triggers on its own (away from edges)
#define STILL_SPEED_CMS     22    // tolerates breathing and small hand/limb twitches on floor
#define MOVE_SPEED_CMS      35    // speed required while moving away to count as walking
#define MOVE_CANCEL_MS    1200    // sustained walking time required to cancel alert
#define RECOVERY_DIST_MM   800    // MUST move at least 80cm from fall spot to count as "got up & walked"
#define FLOOR_RADIUS_MM    500    // within 50cm of impact = still lying in the fall zone (ignores hand waving)
#define SETTLE_MS          400    // wait for body to hit the floor before locking impactX/Y
#define STILL_TIME_MS     3000    // time spent in fall zone to confirm fall
#define SUSPECT_TIMEOUT_MS 10000  // give up if not confirmed in this time
#define MAX_STEP_MM        600    // max distance a target can shift per 100ms frame
#define EDGE_Y_MM         5000    // beyond this distance, "lost" = walked out of view
#define COOLDOWN_MS      10000    // pause after an alert

struct Target {
  int x, y, v;
  bool active;
};

enum State { MONITOR, SUSPECT, COOLDOWN };
State state = MONITOR;

// Last 2 speeds per target (-1 = target slot was inactive)
int hist[3][2] = {{-1, -1}, {-1, -1}, {-1, -1}};

unsigned long suspectStart = 0, stillSince = 0, movingSince = 0, cooldownStart = 0;
int fx = 0, fy = 0;                 // current tracked position of suspected faller
int impactX = 0, impactY = 0;       // anchored coordinates where the person landed
bool impactLocked = false;          // true once SETTLE_MS has elapsed and landing spot is locked

uint32_t packetCount = 0;

// Decode LD2450 16-bit sign-magnitude integer (bit 15 = 1 -> positive, 0 -> negative)
int16_t decode(uint8_t lo, uint8_t hi) {
  uint16_t raw = lo | (uint16_t(hi) << 8);
  int16_t mag = raw & 0x7FFF;
  return (raw & 0x8000) ? mag : -mag;
}

// True if last known spot is near the edge of the sensor's FOV (~+-55 deg or >5m)
bool nearEdge(int x, int y) {
  return (y > EDGE_Y_MM) || (abs(x) > (long)y * 14 / 10);
}

void processFrame(Target t[3]) {
  unsigned long now = millis();
  if (now == 0) now = 1; // prevent 0 sentinel collision on timer rollover

  switch (state) {

    case MONITOR:
      for (int i = 0; i < 3; i++) {
        if (!t[i].active) continue;
        int absV = abs(t[i].v);

        // Calculate acceleration jump only if target was active in recent frames
        int jump = 0;
        if (hist[i][0] >= 0 && hist[i][1] >= 0) {
          int minRecent = hist[i][0] < hist[i][1] ? hist[i][0] : hist[i][1];
          jump = absV - minRecent;
        } else if (hist[i][0] >= 0) {
          jump = absV - hist[i][0];
        }

        // Trigger on sharp acceleration OR high velocity inside the core FOV
        bool burst = (absV >= SPEED_PEAK_CMS && jump >= SPEED_JUMP_CMS) ||
                     (absV >= SPEED_HIGH_CMS && !nearEdge(t[i].x, t[i].y));

        if (burst) {
          state = SUSPECT;
          suspectStart = now;
          stillSince = 0;
          movingSince = 0;
          fx = t[i].x;
          fy = t[i].y;
          impactLocked = false; // will lock impactX/impactY right after SETTLE_MS
          Serial.printf(">> Sudden movement (V=%d cm/s, jump=%d). Checking...\n",
                        t[i].v, jump);
          break;
        }
      }
      break;

    case SUSPECT: {
      if (now - suspectStart > SUSPECT_TIMEOUT_MS) {
        Serial.println(">> Cancelled: timeout");
        state = MONITOR;
        break;
      }

      // 1. Always track the closest active target within MAX_STEP_MM, even during SETTLE_MS
      int best = -1;
      long bestDistSq = (long)MAX_STEP_MM * MAX_STEP_MM;
      for (int i = 0; i < 3; i++) {
        if (!t[i].active) continue;
        long dx = t[i].x - fx;
        long dy = t[i].y - fy;
        long dSq = dx * dx + dy * dy;
        if (dSq <= bestDistSq) {
          bestDistSq = dSq;
          best = i;
        }
      }

      // Calculate 2D positional step speed in cm/s (assuming ~10Hz / 100ms frame rate)
      int stepSpeedCms = 0;
      if (best >= 0) {
        stepSpeedCms = (int)sqrt((double)bestDistSq);
        fx = t[best].x;
        fy = t[best].y;
      }

      // 2. Allow the body to settle for first 400ms, then lock the landing coordinates
      if (now - suspectStart < SETTLE_MS) break;

      if (!impactLocked) {
        impactX = fx;
        impactY = fy;
        impactLocked = true;
        Serial.printf(">> Impact anchored at X:%d Y:%d mm\n", impactX, impactY);
      }

      // Distance from where the person landed on the floor
      long dxImpact = fx - impactX;
      long dyImpact = fy - impactY;
      int distFromImpactMm = (int)sqrt((double)(dxImpact * dxImpact + dyImpact * dyImpact));

      // 3. Evaluate state: vanished on floor, lying in fall zone (even waving hands), or walked away
      bool onFloorAndStill;
      if (best < 0) {
        // Target vanished. Near the edge, assume they walked out of the room;
        // inside the room, assume they are lying flat on the floor (radar blind spot).
        if (nearEdge(fx, fy)) {
          Serial.println(">> Cancelled: target left view");
          state = MONITOR;
          break;
        }
        onFloorAndStill = true;
        movingSince = 0;
      } else {
        int absV = abs(t[best].v);
        int effectiveSpeed = max(absV, stepSpeedCms);

        // ONLY cancel if the person is moving fast enough AND has displaced >= 80cm from impact spot.
        // Waving a hand on the floor has high absV, but distFromImpactMm stays within FLOOR_RADIUS_MM.
        if (effectiveSpeed >= MOVE_SPEED_CMS && distFromImpactMm >= RECOVERY_DIST_MM) {
          if (movingSince == 0) movingSince = now;
          if (now - movingSince >= MOVE_CANCEL_MS) {
            Serial.printf(">> Cancelled: person got up and walked away (dist=%d mm)\n", distFromImpactMm);
            state = MONITOR;
            break;
          }
          onFloorAndStill = false;
        } else {
          movingSince = 0;
          // Count as "on floor" if speed is low OR their body remains inside the 50cm fall zone
          onFloorAndStill = (effectiveSpeed <= STILL_SPEED_CMS) || (distFromImpactMm <= FLOOR_RADIUS_MM);
        }
      }

      // 4. Confirm fall if person remains in the fall state for STILL_TIME_MS
      if (onFloorAndStill) {
        if (stillSince == 0) stillSince = now;
        if (now - stillSince >= STILL_TIME_MS) {
          Serial.println("*****************************");
          Serial.printf("***   FALL DETECTED!      *** (X:%d Y:%d mm)\n", fx, fy);
          Serial.println("*****************************");
          // TODO: trigger buzzer / send MQTT or HTTP alert here
          state = COOLDOWN;
          cooldownStart = now;
        }
      } else {
        stillSince = 0;
      }
      break;
    }

    case COOLDOWN:
      if (now - cooldownStart >= COOLDOWN_MS) {
        Serial.println(">> Monitoring resumed");
        state = MONITOR;
      }
      break;
  }

  // Shift speed history (-1 = inactive target)
  for (int i = 0; i < 3; i++) {
    hist[i][1] = hist[i][0];
    hist[i][0] = t[i].active ? abs(t[i].v) : -1;
  }
}

void setup() {
  Serial.begin(115200);
  Serial2.begin(256000, SERIAL_8N1, RXD2, TXD2);
  Serial.println("\n--- LD2450 Fall Detection started ---");
}

void loop() {
  static uint8_t buf[30];
  static int idx = 0;
  const uint8_t HEADER[4] = {0xAA, 0xFF, 0x03, 0x00};

  while (Serial2.available()) {
    uint8_t b = Serial2.read();

    // Sync to the 4-byte LD2450 frame header (AA FF 03 00)
    if (idx < 4) {
      if (b == HEADER[idx]) {
        buf[idx++] = b;
      } else if (b == HEADER[0]) {
        buf[0] = b;
        idx = 1;
      } else {
        idx = 0;
      }
      continue;
    }

    buf[idx++] = b;

    // Full 30-byte packet accumulated
    if (idx == 30) {
      if (buf[28] == 0x55 && buf[29] == 0xCC) {
        packetCount++;

        Target t[3];
        for (int i = 0; i < 3; i++) {
          int o = 4 + i * 8;
          t[i].x = decode(buf[o],     buf[o + 1]);
          t[i].y = decode(buf[o + 2], buf[o + 3]);
          t[i].v = decode(buf[o + 4], buf[o + 5]);
          t[i].active = !(t[i].x == 0 && t[i].y == 0);
        }

        processFrame(t);   // run detection on EVERY valid frame

        // Radar data line for ld2450_radar.html
        // Format: D,x1,y1,v1,x2,y2,v2,x3,y3,v3,state
        Serial.printf("D,%d,%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
          t[0].x, t[0].y, t[0].v,
          t[1].x, t[1].y, t[1].v,
          t[2].x, t[2].y, t[2].v,
          (int)state);

        idx = 0;
      } else {
        // Corrupt frame tail: scan buffer for next valid header instead of dropping all 30 bytes
        int nextHeader = -1;
        for (int s = 1; s <= 26; s++) {
          if (buf[s] == 0xAA && buf[s + 1] == 0xFF && buf[s + 2] == 0x03 && buf[s + 3] == 0x00) {
            nextHeader = s;
            break;
          }
        }
        if (nextHeader > 0) {
          idx = 30 - nextHeader;
          memmove(buf, buf + nextHeader, idx);
        } else {
          idx = 0;
        }
      }
    }
  }
}
