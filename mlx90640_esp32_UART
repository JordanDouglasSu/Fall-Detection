#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>
#include <HardwareSerial.h>

// ========================== HARDWARE & PINS ==========================
#define RXD2 16               // ESP32 RX2 <- GY-MCU90640 TX
#define TXD2 17               // ESP32 TX2 -> GY-MCU90640 RX
#define ALERT_LED_PIN 2       // Onboard ESP32 LED indicator

HardwareSerial SensorSerial(2);
WebServer server(80);

const uint32_t BAUDS[2] = {115200, 460800};
int baudIdx = 0;
unsigned long baudStart = 0;

// ========================== TUNING ==================================
#define BODY_DELTA_C       1.5f   // Pixel must be this much above median background
#define MIN_BODY_PIXELS    6      // Minimum warm pixels to count as a person
#define DROP_TRIGGER       3.0f   // Sudden centroid drop (rows) = possible fall
#define AR_TRIGGER         1.20f  // Initial wide shape low in frame = possible fall
#define ROW_TRIGGER        13.5f  // Initial centroid row threshold
#define AR_FALL            1.25f  // Confirmed horizontal body aspect ratio (W / H)
#define ROW_FLOOR          13.0f  // Confirmed floor centroid row (0=top, 23=bottom)
#define BOTTOM_ROW_FLOOR   17     // Lowest pixel of bounding box must touch floor zone
#define AR_UPRIGHT         0.90f  // Upright body aspect ratio -> person recovered
#define CONFIRM_MS         3500   // Must stay horizontal on floor this long to confirm
#define SUSPECT_TIMEOUT_MS 10000  // Cancel unconfirmed suspicion after 10s
#define ALERT_HOLD_MS      60000  // Re-evaluate a latched alert after 60s
#define STRICT_CHECKSUM    0      // Set to 1 to drop frames that fail 16-bit checksum

// ======================= BUFFERS & STATE ============================
const uint16_t FRAME_PIXELS = 768;  // 32x24
const uint16_t FRAME_LEN    = 1544; // 4 header + 1536 pixels + 2 ambient + 2 checksum

uint8_t rxBuffer[FRAME_LEN];
uint16_t bIndex = 0;

// Static/Global buffers prevent 8KB ESP32 loopTask stack overflow
float thermalFrame[FRAME_PIXELS];
float tmpFrame[FRAME_PIXELS];
float sortedFrame[FRAME_PIXELS];

float ambientTemp = 25.0f, background = 25.0f;
float minTemp = 20.0f, maxTemp = 35.0f;

uint32_t frameCount = 0, badChecksum = 0;
unsigned long lastFrameMs = 0;

int bbox_x1 = -1, bbox_y1 = -1, bbox_x2 = -1, bbox_y2 = -1;
float centroidY = 0.0f, prevCentroidY = -1.0f, aspectRatio = 0.0f;
bool fallDetected = false;
unsigned long stateStart = 0;
unsigned long horizontalStart = 0;

enum FallState { STANDING, POTENTIAL_FALL, FALL_ALERT };
FallState systemState = STANDING;

