// ======================== WEB SERVER HANDLERS =======================
void setAlert(bool on) {
  fallDetected = on;
  digitalWrite(ALERT_LED_PIN, on ? HIGH : LOW);
}

void handleRoot() {
  server.send_P(200, "text/html", INDEX_HTML);
}

void handleReset() {
  systemState = STANDING;
  horizontalStart = 0;
  setAlert(false);
  prevCentroidY = -1.0f;
  server.send(200, "text/plain", "ok");
}

void handleData() {
  unsigned long age = frameCount ? (millis() - lastFrameMs) : 99999;
  String json;
  json.reserve(3900);
  json += "{\"min\":";  json += String(minTemp, 1);
  json += ",\"max\":";  json += String(maxTemp, 1);
  json += ",\"bg\":";   json += String(background, 1);
  json += ",\"ar\":";   json += String(aspectRatio, 2);
  json += ",\"cy\":";   json += String(centroidY, 1);
  json += ",\"fall\":"; json += (fallDetected ? "true" : "false");
  json += ",\"state\":"; json += String((int)systemState);
  json += ",\"age\":";  json += String(age);
  json += ",\"box\":[" + String(bbox_x1) + "," + String(bbox_y1) + "," + String(bbox_x2) + "," + String(bbox_y2);
  json += "],\"pixels\":[";
  for (int i = 0; i < FRAME_PIXELS; i++) {
    json += String(thermalFrame[i], 1);
    if (i < FRAME_PIXELS - 1) json += ",";
  }
  json += "]}";
  server.send(200, "application/json", json);
}

// ===================== FALL DETECTION ALGORITHM =====================
int cmpFloat(const void* a, const void* b) {
  float fa = *(const float*)a, fb = *(const float*)b;
  return (fa > fb) - (fa < fb);
}

void analyzeFrame() {
  // 1. Background = median of the 768 pixels (immune to self-heating chip temp)
  memcpy(sortedFrame, thermalFrame, sizeof(sortedFrame));
  qsort(sortedFrame, FRAME_PIXELS, sizeof(float), cmpFloat);
  background = sortedFrame[FRAME_PIXELS / 2];
  float threshold = background + BODY_DELTA_C;

  int minX = 32, maxX = -1, minY = 24, maxY = -1, count = 0;
  float sumY = 0;

  for (int y = 0; y < 24; y++) {
    for (int x = 0; x < 32; x++) {
      if (thermalFrame[y * 32 + x] > threshold) {
        if (x < minX) minX = x;
        if (x > maxX) maxX = x;
        if (y < minY) minY = y;
        if (y > maxY) maxY = y;
        sumY += y;
        count++;
      }
    }
  }

  unsigned long now = millis();

  // 2. Nobody visible in frame
  if (count < MIN_BODY_PIXELS) {
    bbox_x1 = bbox_y1 = bbox_x2 = bbox_y2 = -1;
    aspectRatio = 0.0f;
    centroidY = 0.0f;
    prevCentroidY = -1.0f;
    horizontalStart = 0;

    if (systemState == POTENTIAL_FALL) {
      systemState = STANDING;
    }
    // Keep FALL_ALERT latched until timeout in case fallen person rolls out of view
    if (systemState == FALL_ALERT && (now - stateStart > ALERT_HOLD_MS)) {
      systemState = STANDING;
      setAlert(false);
    }
    return;
  }

  // 3. Compute Bounding Box & Centroid
  bbox_x1 = minX; bbox_x2 = maxX;
  bbox_y1 = minY; bbox_y2 = maxY;
  aspectRatio = (float)(maxX - minX + 1) / (float)(maxY - minY + 1);
  centroidY = sumY / (float)count;

  float drop = (prevCentroidY < 0.0f) ? 0.0f : (centroidY - prevCentroidY);
  prevCentroidY = centroidY;

  // Floor posture requires horizontal aspect ratio, low centroid, and bottom edge near floor
  bool horizontalOnFloor = (aspectRatio >= AR_FALL) &&
                           (centroidY >= ROW_FLOOR) &&
                           (maxY >= BOTTOM_ROW_FLOOR);

  // 4. State Machine
  switch (systemState) {
    case STANDING:
      if (drop >= DROP_TRIGGER || (aspectRatio >= AR_TRIGGER && centroidY >= ROW_TRIGGER)) {
        systemState = POTENTIAL_FALL;
        stateStart = now;
        horizontalStart = horizontalOnFloor ? now : 0;
        Serial.printf(">> [SUSPECT] Possible fall (AR=%.2f, Cy=%.1f, Ymax=%d, drop=%.1f)\n",
                      aspectRatio, centroidY, maxY, drop);
      }
      break;

    case POTENTIAL_FALL:
      if (horizontalOnFloor) {
        if (horizontalStart == 0) {
          horizontalStart = now; // Start timing continuous floor posture
        }
        if (now - horizontalStart >= CONFIRM_MS) {
          systemState = FALL_ALERT;
          stateStart = now;
          setAlert(true);
          Serial.printf("*** FALL CONFIRMED (AR=%.2f, Cy=%.1f, Ymax=%d) ***\n",
                        aspectRatio, centroidY, maxY);
        }
      } else {
        // Person is not currently horizontal on the floor; reset continuous floor timer
        horizontalStart = 0;

        if (aspectRatio < AR_UPRIGHT && centroidY < ROW_FLOOR) {
          systemState = STANDING;
          Serial.println(">> [RECOVERED] Cancelled: person upright");
        } else if (now - stateStart >= SUSPECT_TIMEOUT_MS) {
          systemState = STANDING;
          Serial.println(">> [CANCELLED] Suspect timeout expired");
        }
      }
      break;

    case FALL_ALERT:
      if (aspectRatio < 0.85f && centroidY < ROW_FLOOR) {
        systemState = STANDING;
        horizontalStart = 0;
        setAlert(false);
        Serial.println(">> [CLEARED] Person stood up, alert cleared");
      } else if (now - stateStart >= ALERT_HOLD_MS) {
        systemState = STANDING;
        horizontalStart = 0;
        setAlert(false);
      }
      break;
  }
}

// ====================== PACKET PROCESSING ===========================
void processPacket() {
  // 16-bit Little-Endian word sum of the first 1542 bytes (771 words)
  uint16_t sum = 0;
  for (uint16_t i = 0; i < FRAME_LEN - 2; i += 2) {
    sum += (uint16_t)(rxBuffer[i] | (rxBuffer[i + 1] << 8));
  }
  uint16_t got = (uint16_t)(rxBuffer[FRAME_LEN - 2] | (rxBuffer[FRAME_LEN - 1] << 8));

  if (sum != got) {
    badChecksum++;
#if STRICT_CHECKSUM
    return;
#endif
  }

  // Unpack 768 pixels: Little-Endian int16 / 100, starting at byte 4
  float mn = 1000.0f, mx = -1000.0f;
  for (int i = 0; i < FRAME_PIXELS; i++) {
    int16_t raw = (int16_t)(rxBuffer[4 + i * 2] | (rxBuffer[5 + i * 2] << 8));
    float t = raw / 100.0f;
    if (t < -20.0f || t > 150.0f) return; // Reject corrupted frame
    tmpFrame[i] = t;
    if (t < mn) mn = t;
    if (t > mx) mx = t;
  }

  memcpy(thermalFrame, tmpFrame, sizeof(tmpFrame));
  minTemp = mn;
  maxTemp = mx;
  ambientTemp = (int16_t)(rxBuffer[1540] | (rxBuffer[1541] << 8)) / 100.0f;

  frameCount++;
  lastFrameMs = millis();
  analyzeFrame();
}

// ============================== SETUP ===============================
void startSensorUart() {
  SensorSerial.end();
  SensorSerial.setRxBufferSize(2048);
  SensorSerial.begin(BAUDS[baudIdx], SERIAL_8N1, RXD2, TXD2);
  bIndex = 0;
  baudStart = millis();

  // Command GY-MCU90640 to enable continuous auto-frame output
  const uint8_t autoCmd[] = {0xA5, 0x35, 0x02, 0xDC};
  SensorSerial.write(autoCmd, sizeof(autoCmd));

  Serial.printf("Sensor UART started at %lu baud\n", (unsigned long)BAUDS[baudIdx]);
}

void setup() {
  Serial.begin(115200);
  pinMode(ALERT_LED_PIN, OUTPUT);
  digitalWrite(ALERT_LED_PIN, LOW);

  WiFi.softAP("ESP32-Thermal-Fall", "12345678");
  Serial.print("\nAP online. Dashboard: http://");
  Serial.println(WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.on("/reset", handleReset);
  server.begin();

  startSensorUart();
}

// ============================== LOOP ================================
void loop() {
  server.handleClient();

  while (SensorSerial.available()) {
    uint8_t b = SensorSerial.read();

    if (bIndex == 0) {
      if (b == 0x5A) rxBuffer[bIndex++] = b;
      continue;
    }
    if (bIndex == 1) {
      if (b == 0x5A) rxBuffer[bIndex++] = b;
      else bIndex = 0;
      continue;
    }
    if (bIndex == 2) {
      if (b == 0x02) rxBuffer[bIndex++] = b;
      else if (b == 0x5A) bIndex = 2; // Stay synced if previous checksum ended with 0x5A
      else bIndex = 0;
      continue;
    }
    if (bIndex == 3) {
      if (b == 0x06) rxBuffer[bIndex++] = b;
      else bIndex = 0;
      continue;
    }

    rxBuffer[bIndex++] = b;
    if (bIndex >= FRAME_LEN) {
      processPacket();
      bIndex = 0;
    }
  }

  // No frame yet: alternate between 115200 and 460800 baud every 5 seconds
  if (frameCount == 0 && (millis() - baudStart > 5000)) {
    Serial.println("No frames received yet, switching baud rate...");
    baudIdx ^= 1;
    startSensorUart();
  }

  // 1 Hz status line
  static unsigned long lastLog = 0;
  if (millis() - lastLog >= 1000) {
    lastLog = millis();
    Serial.printf("frames:%lu badCsum:%lu | max:%.1f bg:%.1f | AR:%.2f Cy:%.1f Ymax:%d | state:%d\n",
                  (unsigned long)frameCount, (unsigned long)badChecksum,
                  maxTemp, background, aspectRatio, centroidY, bbox_y2, (int)systemState);
  }
}
