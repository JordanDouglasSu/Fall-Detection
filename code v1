// ---------- Tunable thresholds (speeds in cm/s) ----------
#define SPEED_PEAK_CMS      45    // min speed to count as a fall burst (was 100)
#define SPEED_JUMP_CMS      25    // rise vs. slowest of last 3 frames (was 70)
#define SPEED_HIGH_CMS     100    // very fast movement triggers on its own
#define STILL_SPEED_CMS     10    // below this = not moving (was 5)
#define MOVE_SPEED_CMS      35    // above this = person is up and moving (was 20)
#define SETTLE_MS          400    // ignore data right after the burst
#define STILL_TIME_MS     2000    // must stay still/missing this long (was 3000)
#define SUSPECT_TIMEOUT_MS 12000  // give up if not confirmed in this time
#define TRACK_RADIUS_MM    2000   // how far the person may move (was 1500)
#define COOLDOWN_MS        8000

struct Target { int x, y, v; bool active; };

enum State { MONITOR, SUSPECT, COOLDOWN };
State state = MONITOR;

int hist[3][3] = {{0}};             // last 3 speeds per target
unsigned long suspectStart = 0, stillSince = 0, cooldownStart = 0;
int fx = 0, fy = 0;

unsigned long lastPrint = 0;
uint32_t packetCount = 0;

int16_t decode(uint8_t lo, uint8_t hi) {
  uint16_t raw = lo | (hi << 8);
  int16_t mag = raw & 0x7FFF;
  return (raw & 0x8000) ? mag : -mag;
}

void processFrame(Target t[3]) {
  unsigned long now = millis();

  switch (state) {

    case MONITOR:
      for (int i = 0; i < 3; i++) {
        if (!t[i].active) continue;
        int absV = abs(t[i].v);
        int minRecent = min(hist[i][0], min(hist[i][1], hist[i][2]));
        int jump = absV - minRecent;
        bool burst = (absV >= SPEED_PEAK_CMS && jump >= SPEED_JUMP_CMS) ||
                     (absV >= SPEED_HIGH_CMS);
        if (burst) {
          state = SUSPECT;
          suspectStart = now;
          stillSince = 0;
          fx = t[i].x;
          fy = t[i].y;
          Serial.printf(">> Sudden movement (V=%d cm/s, jump=%d). Checking...\n",
                        t[i].v, jump);
          break;
        }
      }
      break;

    case SUSPECT: {
      if (now - suspectStart > SUSPECT_TIMEOUT_MS) {
        Serial.println(">> Cancelled: timeout");
        state = MONITOR;
        break;
      }
      if (now - suspectStart < SETTLE_MS) break;

      // Find the active target closest to the last known position
      int best = -1;
      long bestDist = (long)TRACK_RADIUS_MM * TRACK_RADIUS_MM;
      for (int i = 0; i < 3; i++) {
        if (!t[i].active) continue;
        long dx = t[i].x - fx, dy = t[i].y - fy;
        long d = dx * dx + dy * dy;
        if (d <= bestDist) { bestDist = d; best = i; }
      }

      bool still;
      if (best < 0) {
        still = true;                    // target vanished: treat as lying still
      } else {
        fx = t[best].x;
        fy = t[best].y;
        int absV = abs(t[best].v);
        if (absV >= MOVE_SPEED_CMS) {    // clearly moving again: not a fall
          Serial.println(">> Cancelled: person moving normally");
          state = MONITOR;
          break;
        }
        still = (absV <= STILL_SPEED_CMS);
      }

      if (still) {
        if (stillSince == 0) stillSince = now;
        if (now - stillSince >= STILL_TIME_MS) {
          Serial.println("*****************************");
          Serial.printf("***   FALL DETECTED!      *** (X:%d Y:%d mm)\n", fx, fy);
          Serial.println("*****************************");
          state = COOLDOWN;
          cooldownStart = now;
        }
      } else {
        stillSince = 0;                  // small movement, restart the timer
      }
      break;
    }

    case COOLDOWN:
      if (now - cooldownStart >= COOLDOWN_MS) {
        Serial.println(">> Monitoring resumed");
        state = MONITOR;
      }
      break;
  }

  // Shift speed history (keeps last 3 frames per target)
  for (int i = 0; i < 3; i++) {
    hist[i][2] = hist[i][1];
    hist[i][1] = hist[i][0];
    hist[i][0] = t[i].active ? abs(t[i].v) : 0;
  }
}
